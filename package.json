{
  "name": "file-sessions",
  "displayName": "File Sessions",
  "description": "Save, manage, and restore groups of open files in your workspace",
  "version": "1.1.1",
  "publisher": "rodrigocvv",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodrigocvv/file-sessions.git"
  },
  "bugs": {
    "url": "https://github.com/rodrigocvv/file-sessions/issues"
  },
  "homepage": "https://github.com/rodrigocvv/file-sessions#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sessions",
    "files",
    "workspace",
    "tabs",
    "restore"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fileSessions",
          "title": "File Sessions",
          "icon": "resources/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "fileSessions": [
        {
          "id": "fileSessions.sessionsView",
          "name": "Saved Sessions",
          "icon": "$(folder-library)"
        },
        {
          "id": "fileSessions.branchSessionsView",
          "name": "Branch Sessions",
          "icon": "$(git-branch)"
        },
        {
          "id": "fileSessions.timelineView",
          "name": "Timeline",
          "icon": "$(history)"
        }
      ]
    },
    "commands": [
      {
        "command": "fileSessions.saveSession",
        "title": "Save File Session",
        "category": "File Sessions",
        "icon": "$(save)"
      },
      {
        "command": "fileSessions.openSession",
        "title": "Open Session",
        "category": "File Sessions",
        "icon": "$(folder-opened)"
      },
      {
        "command": "fileSessions.openFiles",
        "title": "Open Files",
        "category": "File Sessions",
        "icon": "$(files)"
      },
      {
        "command": "fileSessions.renameSession",
        "title": "Rename Session",
        "category": "File Sessions",
        "icon": "$(edit)"
      },
      {
        "command": "fileSessions.deleteSession",
        "title": "Delete Session",
        "category": "File Sessions",
        "icon": "$(trash)"
      },
      {
        "command": "fileSessions.addFileToSession",
        "title": "Add Current File to Session",
        "category": "File Sessions",
        "icon": "$(add)"
      },
      {
        "command": "fileSessions.removeFileFromSession",
        "title": "Remove File(s) from Session",
        "category": "File Sessions",
        "icon": "$(close)"
      },
      {
        "command": "fileSessions.openSelectedFiles",
        "title": "Open File(s)",
        "category": "File Sessions",
        "icon": "$(go-to-file)"
      },
      {
        "command": "fileSessions.openBranchSession",
        "title": "Open Branch Session",
        "category": "File Sessions",
        "icon": "$(folder-opened)"
      },
      {
        "command": "fileSessions.deleteBranchSession",
        "title": "Delete Branch Session",
        "category": "File Sessions",
        "icon": "$(trash)"
      },
      {
        "command": "fileSessions.openBranchFile",
        "title": "Open File",
        "category": "File Sessions",
        "icon": "$(file)"
      },
      {
        "command": "fileSessions.removeFileFromBranchSession",
        "title": "Remove File from Branch Session",
        "category": "File Sessions",
        "icon": "$(close)"
      },
      {
        "command": "fileSessions.restoreTimelineSnapshot",
        "title": "Restore Snapshot",
        "category": "File Sessions",
        "icon": "$(history)"
      },
      {
        "command": "fileSessions.deleteTimelineSnapshot",
        "title": "Delete Snapshot",
        "category": "File Sessions",
        "icon": "$(trash)"
      },
      {
        "command": "fileSessions.clearAllTimelineSnapshots",
        "title": "Clear All Timeline",
        "category": "File Sessions",
        "icon": "$(clear-all)"
      },
      {
        "command": "fileSessions.openSettings",
        "title": "Open Extension Settings",
        "category": "File Sessions",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fileSessions.saveSession",
          "when": "view == fileSessions.sessionsView",
          "group": "navigation"
        },
        {
          "command": "fileSessions.openSettings",
          "when": "view == fileSessions.sessionsView",
          "group": "navigation"
        },
        {
          "command": "fileSessions.openSettings",
          "when": "view == fileSessions.branchSessionsView",
          "group": "navigation"
        },
        {
          "command": "fileSessions.clearAllTimelineSnapshots",
          "when": "view == fileSessions.timelineView",
          "group": "navigation"
        },
        {
          "command": "fileSessions.openSettings",
          "when": "view == fileSessions.timelineView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "fileSessions.openSession",
          "when": "view == fileSessions.sessionsView && viewItem == session",
          "group": "inline"
        },
        {
          "command": "fileSessions.addFileToSession",
          "when": "view == fileSessions.sessionsView && viewItem == session",
          "group": "inline"
        },
        {
          "command": "fileSessions.openFiles",
          "when": "view == fileSessions.sessionsView && viewItem == session",
          "group": "open@1"
        },
        {
          "command": "fileSessions.renameSession",
          "when": "view == fileSessions.sessionsView && viewItem == session",
          "group": "manage@1"
        },
        {
          "command": "fileSessions.deleteSession",
          "when": "view == fileSessions.sessionsView && viewItem == session",
          "group": "manage@2"
        },
        {
          "command": "fileSessions.removeFileFromSession",
          "when": "view == fileSessions.sessionsView && viewItem == sessionFile",
          "group": "inline"
        },
        {
          "command": "fileSessions.openSelectedFiles",
          "when": "view == fileSessions.sessionsView && viewItem == sessionFile",
          "group": "open@1"
        },
        {
          "command": "fileSessions.removeFileFromSession",
          "when": "view == fileSessions.sessionsView && viewItem == sessionFile",
          "group": "manage@1"
        },
        {
          "command": "fileSessions.openBranchSession",
          "when": "view == fileSessions.branchSessionsView && viewItem == branchSession",
          "group": "inline"
        },
        {
          "command": "fileSessions.deleteBranchSession",
          "when": "view == fileSessions.branchSessionsView && viewItem == branchSession",
          "group": "manage@1"
        },
        {
          "command": "fileSessions.removeFileFromBranchSession",
          "when": "view == fileSessions.branchSessionsView && viewItem == branchSessionFile",
          "group": "inline"
        },
        {
          "command": "fileSessions.restoreTimelineSnapshot",
          "when": "view == fileSessions.timelineView && viewItem == timelineSnapshot",
          "group": "inline"
        },
        {
          "command": "fileSessions.deleteTimelineSnapshot",
          "when": "view == fileSessions.timelineView && viewItem == timelineSnapshot",
          "group": "manage@1"
        }
      ],
      "commandPalette": [
        {
          "command": "fileSessions.saveSession"
        },
        {
          "command": "fileSessions.openSession",
          "when": "false"
        },
        {
          "command": "fileSessions.openFiles",
          "when": "false"
        },
        {
          "command": "fileSessions.renameSession",
          "when": "false"
        },
        {
          "command": "fileSessions.deleteSession",
          "when": "false"
        },
        {
          "command": "fileSessions.addFileToSession",
          "when": "false"
        },
        {
          "command": "fileSessions.removeFileFromSession",
          "when": "false"
        },
        {
          "command": "fileSessions.openSelectedFiles",
          "when": "false"
        },
        {
          "command": "fileSessions.openBranchSession",
          "when": "false"
        },
        {
          "command": "fileSessions.deleteBranchSession",
          "when": "false"
        },
        {
          "command": "fileSessions.openBranchFile",
          "when": "false"
        },
        {
          "command": "fileSessions.removeFileFromBranchSession",
          "when": "false"
        },
        {
          "command": "fileSessions.restoreTimelineSnapshot",
          "when": "false"
        },
        {
          "command": "fileSessions.deleteTimelineSnapshot",
          "when": "false"
        },
        {
          "command": "fileSessions.clearAllTimelineSnapshots",
          "when": "false"
        },
        {
          "command": "fileSessions.openSettings"
        }
      ]
    },
    "configuration": {
      "title": "File Sessions",
      "properties": {
        "fileSessions.closeExistingEditorsOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Close existing editors that are not part of the session when opening it"
        },
        "fileSessions.gitBranchSessions.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic file sessions for Git branches"
        },
        "fileSessions.gitBranchSessions.autoCreate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically create branch sessions when switching to a new branch"
        },
        "fileSessions.gitBranchSessions.autoRestoreOnSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Automatically restore files when switching to a branch with an existing session"
        },
        "fileSessions.timeline.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic timeline snapshots of workspace context"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0"
  }
}
